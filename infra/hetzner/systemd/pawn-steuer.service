[Unit]
Description=PAWN Steuerpult (signierte Fernbedienung)
After=network-online.target
Wants=network-online.target

[Service]
Environment=STEUER_HOST=127.0.0.1
Environment=STEUER_PORT=7070
ExecStart=/usr/bin/node /opt/pawn/repo/infra/hetzner/steuer/steuer.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
